# Copy this file to `.env` (local dev) and fill in real values.
# Never commit `.env` with secrets — only SUPABASE_URL and the publishable
# key are safe to expose (Supabase's Row Level Security protects the data,
# not the key). Everything else here is a server-side secret.

# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Same values, exposed to the browser build (Vite only injects VITE_* vars).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paddle (billing) ---------------------------------------------------
# Paddle Dashboard -> Developer Tools -> Authentication.
PADDLE_SANDBOX_API_KEY=
PADDLE_LIVE_API_KEY=
# Paddle Dashboard -> Developer Tools -> Notifications -> (your webhook
# destination) -> Secret Key. One secret per destination/environment.
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
# Paddle.js client-side token (safe to expose). Starts with "test_" in
# sandbox and "live_" in production — this prefix is what the app uses to
# decide which environment it's running in (see src/lib/payments-env.ts).
VITE_PAYMENTS_CLIENT_TOKEN=

# --- AI support assistant (Google Gemini) --------------------------------
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
